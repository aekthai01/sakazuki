# ============================================================
# UPLOAD DIRECTORY — CRITICAL SECURITY
# Prevent PHP execution and restrict file types
# ============================================================

# Completely disable PHP execution
<FilesMatch "\.ph(p[0-9]?|tml|ps)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable script execution
Options -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps

# Only allow image files
<FilesMatch "\.(?!(jpg|jpeg|png|gif|webp|ico)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory listing
Options -Indexes
